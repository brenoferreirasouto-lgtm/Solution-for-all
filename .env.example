# Copie este arquivo para .env (o .env não vai para o git).

# Em desenvolvimento pode deixar assim. Em produção: DEBUG=False e uma chave longa e secreta.
DEBUG=True
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Separados por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Sem DATABASE_URL o projeto usa o SQLite (arquivo db.sqlite3).
# Exemplo de PostgreSQL no deploy:
# DATABASE_URL=postgres://usuario:senha@host:5432/solution_for_all

# IA (entrega #2). Sem chave, o app usa a IA simulada e nada sai do app.
# Crie uma chave gratuita em https://console.groq.com/keys (cada pessoa do grupo cria a sua).
# Depois confira com: python manage.py testar_ia
GROQ_API_KEY=
# Opcional. Padrão: openai/gpt-oss-120b e, quando ele bate no limite gratuito, openai/gpt-oss-20b.
# GROQ_MODELO=openai/gpt-oss-120b
# GROQ_MODELO_RESERVA=openai/gpt-oss-20b
# Desliga a IA de verdade mesmo com a chave acima (ex.: apresentação sem internet).
# IA_PROVEDOR=simulada
# Segundos de espera pela resposta da IA.
# IA_TIMEOUT=30
