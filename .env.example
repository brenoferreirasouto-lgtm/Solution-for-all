# Copie este arquivo para .env (o .env não vai para o git).

# Em desenvolvimento pode deixar assim. Em produção: DEBUG=False e uma chave longa e secreta.
DEBUG=True
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Separados por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Sem DATABASE_URL o projeto usa o SQLite (arquivo db.sqlite3).
# Exemplo de PostgreSQL no deploy:
# DATABASE_URL=postgres://usuario:senha@host:5432/solution_for_all
